<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Android 12+ always draws a system splash before the first frame, by
         default the launcher icon on the window background. Foundation opens
         on its own hero (AppLoadingScreen), so the system splash is a blank
         page in the same colour and the hero is the first thing people see. -->
    <style name="Theme.Foundation" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/background_primary</item>
        <item name="android:navigationBarColor">@color/background_primary</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">@color/background_primary</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowSplashScreenBackground">@color/background_primary</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
</resources>
