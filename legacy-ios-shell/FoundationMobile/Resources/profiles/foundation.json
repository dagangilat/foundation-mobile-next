{
  "schemaVersion": 4,
  "profile": {
    "id": "foundation",
    "label": "Foundation",
    "description": "The default Foundation look — the base Edition every white-label derives from. Document-capture flow (App Attest + active liveness + anti-spoof + face match against a back-camera capture). Light palette with the composed Your Voice / Share / Market pillar hero.",
    "requiredPhases": [
      "appAttest",
      "liveness",
      "antiSpoof",
      "faceMatch"
    ],
    "faceMatchSource": "documentPhoto",
    "document": {
      "noun": "identity document",
      "short": "ID"
    }
  },
  "splash": {
    "minDurationMs": 900
  },
  "loading": {
    "phaseThresholdsMs": [
      0,
      1500,
      3500,
      7000
    ]
  },
  "liveness": {
    "scanBudgetSeconds": 15,
    "poseHoldMs": 250,
    "activePoses": [
      "straight",
      "left",
      "right"
    ],
    "frameStride": 2,
    "minConfidence": 0.5,
    "poses": {
      "straight": {
        "yaw": 0,
        "pitch": 0,
        "yawTolerance": 0.18,
        "pitchTolerance": 0.18
      },
      "left": {
        "yaw": -0.45,
        "pitch": 0,
        "yawTolerance": 0.15,
        "pitchTolerance": 0.3
      },
      "right": {
        "yaw": 0.45,
        "pitch": 0,
        "yawTolerance": 0.15,
        "pitchTolerance": 0.3
      },
      "up": {
        "yaw": 0,
        "pitch": 0.35,
        "yawTolerance": 0.25,
        "pitchTolerance": 0.15
      },
      "down": {
        "yaw": 0,
        "pitch": -0.35,
        "yawTolerance": 0.25,
        "pitchTolerance": 0.15
      }
    }
  },
  "camera": {
    "frameTimeoutSeconds": 3
  },
  "captureView": {
    "postSealDismissMs": 900
  },
  "antiSpoof": {
    "minScore": 0.55,
    "modelTag": "MiniFASNetV2+V1SE"
  },
  "faceMatch": {
    "cosineThreshold": 0.55
  },
  "theme": {
    "palette": "foundation",
    "branding": {
      "hero": {
        "mode": "pillars"
      }
    }
  },
  "session": {
    "authFreshnessSeconds": 600
  },
  "support": {
    "maxPerSession": 3
  },
  "pairing": {
    "enabled": false
  },
  "deployments": [
    {
      "id": "production",
      "name": "Production",
      "description": "Live platform — foundation-global.com",
      "version": "1.0",
      "webUrl": "https://foundation-global.com",
      "plist": "GoogleService-Info"
    },
    {
      "id": "staging",
      "name": "Staging",
      "description": "Test environment — staging.foundation-global.com",
      "version": "1.0-rc",
      "webUrl": "https://staging.foundation-global.com",
      "plist": "GoogleService-Info-staging"
    }
  ],
  "palette": {
    "canvas": "#ffffff",
    "surface": "#f6f9fc",
    "border": "#e6ebf1",
    "ink": "#0a0e27",
    "muted": "#596171",
    "brand": "#34d399",
    "brandAlt": "#22d3ee",
    "brandInk": "#047857",
    "brandInkHover": "#065f46",
    "gradient": "linear-gradient(100deg, #34d399, #22d3ee 45%, #60a5fa 75%, #a78bfa)",
    "meshBase": "#e8fbf4",
    "meshBlobs": [
      "#34d399",
      "#22d3ee",
      "#60a5fa",
      "#a78bfa"
    ]
  }
}
