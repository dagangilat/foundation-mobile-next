{
  "schemaVersion": 4,
  "profile": {
    "id": "hisec-mdl",
    "label": "High Security — Wallet ID",
    "description": "Full credentialed identity via Apple Wallet mDL or national ID. Requires App Attest + Apple Verifier API portrait + active liveness + anti-spoof + face match. Cryptographically validates the credential against the issuing authority’s signature. Suitable for civic identity and financial-grade identity claims.",
    "requiredPhases": [
      "appAttest",
      "nfcZk",
      "liveness",
      "antiSpoof",
      "faceMatch"
    ],
    "faceMatchSource": "mdl",
    "document": {
      "noun": "driving licence or Wallet ID",
      "short": "Wallet ID"
    }
  },
  "splash": {
    "minDurationMs": 900
  },
  "loading": {
    "phaseThresholdsMs": [
      0,
      1500,
      3500,
      7000
    ]
  },
  "liveness": {
    "scanBudgetSeconds": 15,
    "poseHoldMs": 250,
    "activePoses": [
      "straight",
      "left",
      "right"
    ],
    "frameStride": 2,
    "minConfidence": 0.5,
    "poses": {
      "straight": {
        "yaw": 0.0,
        "pitch": 0.0,
        "yawTolerance": 0.18,
        "pitchTolerance": 0.18
      },
      "left": {
        "yaw": -0.45,
        "pitch": 0.0,
        "yawTolerance": 0.15,
        "pitchTolerance": 0.3
      },
      "right": {
        "yaw": 0.45,
        "pitch": 0.0,
        "yawTolerance": 0.15,
        "pitchTolerance": 0.3
      },
      "up": {
        "yaw": 0.0,
        "pitch": 0.35,
        "yawTolerance": 0.25,
        "pitchTolerance": 0.15
      },
      "down": {
        "yaw": 0.0,
        "pitch": -0.35,
        "yawTolerance": 0.25,
        "pitchTolerance": 0.15
      }
    }
  },
  "camera": {
    "frameTimeoutSeconds": 3
  },
  "mrz": {
    "scanBudgetSeconds": 3
  },
  "theme": {
    "palette": "steel",
    "branding": {
      "logo": {
        "asset": "HiSecLogo"
      },
      "hero": {
        "mode": "pillars"
      }
    }
  },
  "captureView": {
    "postSealDismissMs": 900
  },
  "antiSpoof": {
    "minScore": 0.55,
    "modelTag": "MiniFASNetV2+V1SE"
  },
  "faceMatch": {
    "cosineThreshold": 0.45
  },
  "session": {
    "authFreshnessSeconds": 300
  },
  "support": {
    "maxPerSession": 3
  },
  "pairing": {
    "enabled": false
  },
  "deployments": [
    {
      "id": "production",
      "name": "Production",
      "description": "Live platform — foundation-global.com",
      "version": "1.0",
      "webUrl": "https://foundation-global.com",
      "plist": "GoogleService-Info"
    },
    {
      "id": "staging",
      "name": "Staging",
      "description": "Test environment — staging.foundation-global.com",
      "version": "1.0-rc",
      "webUrl": "https://staging.foundation-global.com",
      "plist": "GoogleService-Info-staging"
    }
  ]
}
