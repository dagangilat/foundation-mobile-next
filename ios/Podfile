platform :ios, '16.0'

# Firebase iOS pods ship Swift modules; dynamic frameworks let the app target
# `import FirebaseAuth` etc. without a bridging header.
use_frameworks!

target 'FoundationMobile' do
  pod 'Firebase/Auth'
  pod 'Firebase/Firestore'
  pod 'Firebase/Functions'
  pod 'FirebaseAppCheck'
end

# Firebase 12 + CocoaPods 1.16 + device SDK surface a strict framework-header
# check that fails on quote-style includes used by GTMSessionFetcher and
# FirebaseMessagingInterop umbrella headers. Simulator builds tolerate them,
# device builds don't. Downgrade to a warning so we don't patch upstream
# headers on every pod install.
post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
    end
  end
end
