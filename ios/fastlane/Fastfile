default_platform(:ios)

# App Store Connect API key auth. Requires these env vars (never commit):
#   APP_STORE_CONNECT_API_KEY_KEY_ID     — 10-char key id from ASC → Users and Access → Integrations
#   APP_STORE_CONNECT_API_KEY_ISSUER_ID  — issuer id from the same page
#   APP_STORE_CONNECT_API_KEY_KEY_CONTENT — contents of the downloaded AuthKey_<ID>.p8 file
#                                           (raw text including the BEGIN/END lines)
def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch('APP_STORE_CONNECT_API_KEY_KEY_ID'),
    issuer_id: ENV.fetch('APP_STORE_CONNECT_API_KEY_ISSUER_ID'),
    key_content: ENV.fetch('APP_STORE_CONNECT_API_KEY_KEY_CONTENT'),
    is_key_content_base64: false,
    in_house: false
  )
end

platform :ios do
  desc "Create the App Store Connect app entry (one-time)."
  lane :produce_app do
    produce(
      api_key: asc_api_key,
      app_identifier: "com.foundationglobal.mobile",
      app_name: "Foundation",
      language: "en-US",
      app_version: "0.1",
      sku: "foundation-mobile-v1",
      platform: "ios"
    )
  end

  desc "Push metadata (description, privacy URL, keywords, icon, screenshots) to ASC."
  desc "Does NOT upload a binary — use :beta or :release for that."
  lane :deliver_metadata do
    deliver(
      api_key: asc_api_key,
      submit_for_review: false,
      automatic_release: false,
      skip_binary_upload: true,
      skip_screenshots: false,
      skip_metadata: false,
      force: true,
      precheck_include_in_app_purchases: false
    )
  end

  desc "Fetch or create the Apple Distribution certificate via the ASC API."
  desc "Idempotent — uses the existing cert if one is already in keychain."
  desc "Run once before :beta if the keychain only has Apple Development."
  lane :certs do
    cert(
      api_key: asc_api_key,
      development: false,
      generate_apple_certs: true
    )
    # Default sigh = App Store distribution profile. Passing both
    # development and adhoc as false trips fastlane's "you can't enable
    # both" guard; just omit them.
    sigh(
      api_key: asc_api_key,
      app_identifier: "com.foundationglobal.mobile",
      force: false
    )
  end

  desc "Build a signed IPA and upload to TestFlight."
  desc "Intended to run from Xcode Cloud, GitHub Actions, or locally."
  desc "Headless CI (no Apple ID logged in) requires manual signing scoped"
  desc "ONLY to the FoundationMobile target — Pods (Firebase et al.) reject"
  desc "manually-specified profiles. Use update_code_signing_settings to"
  desc "patch the .pbxproj per-target before building."
  lane :beta do
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "FoundationMobile.xcodeproj",
      team_id: "F9F26FQW95",
      code_sign_identity: "Apple Distribution",
      profile_name: "Foundation_AppStore",
      bundle_identifier: "com.foundationglobal.mobile",
      targets: ["FoundationMobile"]
    )
    # Pull the latest TestFlight build number for this app and bump by 1.
    # ASC rejects uploads where CFBundleVersion ≤ any previously uploaded
    # build's number, regardless of version string.
    latest = latest_testflight_build_number(
      api_key: asc_api_key,
      app_identifier: "com.foundationglobal.mobile",
      initial_build_number: 0
    )
    increment_build_number(
      build_number: latest + 1,
      xcodeproj: "FoundationMobile.xcodeproj"
    )
    build_app(
      # CocoaPods requires the workspace, not the project — without it,
      # Pods (FirebaseCore et al.) aren't built before the app target.
      workspace: "FoundationMobile.xcworkspace",
      scheme: "FoundationMobile",
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: "F9F26FQW95",
        provisioningProfiles: {
          "com.foundationglobal.mobile" => "Foundation_AppStore",
        },
      },
      xcodebuild_formatter: ""
    )
    upload_to_testflight(
      api_key: asc_api_key,
      skip_waiting_for_build_processing: true,
      changelog: "TestFlight build via App Store Connect API. App Attest in production environment."
    )
  end
end
