# Foundation Mobile (foundation-mobile-next) — a public rebrand fork; see
# README.md and NOTICE for full upstream attribution and licensing.
#
# This file replaces the one inherited from the live foundation-mobile app,
# whose beta lane rewrote the bundle id to that live app's real production
# identifier and uploaded straight to that live App Store Connect record (the
# exact identifier is intentionally not repeated here — see this repo's
# commit history — so this comment itself does not trip the brand-sweep /
# live-identifier CI gates below). Never reintroduce a hardcoded bundle id
# here; it comes from Appfile.
#
# Working-directory note (verified against fastlane's own docs before writing
# this file): every action's own code — including build_app,
# latest_testflight_build_number, upload_to_testflight —
# runs with fastlane's process cwd, which is the directory fastlane was
# invoked from one level ABOVE this fastlane/ folder, i.e. ios/. That is why
# bare relative paths like "FoundationMobile.xcodeproj" below resolve
# correctly. The `sh` action is the one documented exception: it always runs
# relative to THIS fastlane/ folder regardless of where fastlane was invoked
# from, which is why the sh() calls below `cd` up before reaching
# ios/prebuild.sh (one level) or the repo-root scripts/brand-sweep.sh (two
# levels).

default_platform(:ios)

APP_IDENTIFIER = "com.foundationnext.mobile".freeze
TEAM_ID = "F9F26FQW95".freeze

platform :ios do
  desc "Build the identity SDK framework (required before any build)"
  lane :prebuild do
    sh("cd .. && ./prebuild.sh")
  end

  # The ratchet, not the raw sweep: it fails on any brand hit missing from
  # scripts/brand-sweep-baseline/ios.txt. The raw sweep still reports
  # reviewed residue (comments, retained infrastructure hosts) and would
  # stop every upload.
  desc "Fail if any new pre-fork brand token appears"
  lane :brand_sweep do
    sh("cd ../.. && ./scripts/brand-sweep-ratchet.sh ios")
  end

  # Authenticates fastlane and xcodebuild with an App Store Connect API key
  # (App Store Connect > Users and Access > Integrations > App Store Connect
  # API, role App Manager). Supplied through the environment so the .p8 never
  # enters the repo:
  #   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH (absolute path to AuthKey_XXXX.p8)
  private_lane :asc_api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH")
    )
  end

  # Pushes the listing text in fastlane/metadata (name, subtitle, description,
  # keywords, promotional text, category) to the version being prepared in App
  # Store Connect. Text only: no binary, no screenshots, no submission.
  # Support/privacy URLs and review contact details are added as files once
  # they exist (support_url.txt, privacy_url.txt, review_information/*.txt).
  desc "Upload App Store listing text"
  lane :metadata do
    deliver(
      api_key: asc_api_key,
      app_identifier: APP_IDENTIFIER,
      metadata_path: "./fastlane/metadata",
      skip_binary_upload: true,
      skip_screenshots: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      force: true
    )
  end

  desc "Build and upload a TestFlight build"
  lane :beta do
    brand_sweep
    prebuild
    api_key = asc_api_key

    # Build number = latest uploaded + 1, passed on the command line so the
    # project file is never rewritten. The project has no VERSIONING_SYSTEM,
    # so agvtool-based increment_build_number cannot run here; overriding
    # CURRENT_PROJECT_VERSION also keeps the notification extension's build
    # number equal to the app's, which App Store Connect requires.
    build_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      initial_build_number: 0
    ) + 1

    # The project uses automatic signing for team TEAM_ID. With
    # -allowProvisioningUpdates and the API key, xcodebuild creates or
    # refreshes the Apple Distribution certificate and App Store profiles
    # (app, extension, App Group, iCloud container) itself, for both the
    # archive and the export step. No manual profiles or match repo needed.
    auth_xcargs = [
      "-allowProvisioningUpdates",
      "-authenticationKeyPath #{ENV.fetch("ASC_KEY_PATH")}",
      "-authenticationKeyID #{ENV.fetch("ASC_KEY_ID")}",
      "-authenticationKeyIssuerID #{ENV.fetch("ASC_ISSUER_ID")}"
    ].join(" ")

    # "FoundationMobile" is the DEVELOPMENT scheme (Task B2's rename kept
    # the upstream fork's original scheme layout) - its own ArchiveAction builds the
    # "Release (Development)" configuration, which sets the DEVELOPMENT
    # compilation flag (shows a "Development" badge, -dev notification
    # topics, a Debug Options row in Profile). "Production" is the scheme
    # that archives "Release (Production)" and is the one that must ship.
    # Confirmed directly: grep ArchiveAction/buildConfiguration in both
    # ios/FoundationMobile.xcodeproj/xcshareddata/xcschemes/*.xcscheme.
    build_app(
      project: "FoundationMobile.xcodeproj",
      scheme: "Production",
      export_method: "app-store",
      export_team_id: TEAM_ID,
      xcargs: "#{auth_xcargs} CURRENT_PROJECT_VERSION=#{build_number}",
      export_xcargs: auth_xcargs,
      output_directory: "build",
      output_name: "FoundationMobile.ipa"
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      skip_waiting_for_build_processing: true
    )
  end
end
