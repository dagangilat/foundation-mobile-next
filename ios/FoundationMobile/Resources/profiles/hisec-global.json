{
  "schemaVersion": 2,
  "profile": {
    "id": "hisec-global",
    "label": "High Security — Global",
    "description": "Full credentialed identity. Requires App Attest + ePassport NFC + active liveness + anti-spoof + face match against the on-chip DG2 photo. Suitable for global civic identity and financial-grade identity claims.",
    "requiredPhases": ["appAttest", "nfcZk", "liveness", "antiSpoof", "faceMatch"],
    "faceMatchSource": "dg2"
  },
  "splash": {
    "minDurationMs": 900
  },
  "loading": {
    "phaseThresholdsMs": [0, 1500, 3500, 7000]
  },
  "liveness": {
    "scanBudgetSeconds": 15,
    "poseHoldMs": 250,
    "activePoses": ["straight", "left", "right"],
    "frameStride": 2,
    "minConfidence": 0.5,
    "poses": {
      "straight": {"yaw":  0.00, "pitch":  0.00, "yawTolerance": 0.18, "pitchTolerance": 0.18},
      "left":     {"yaw": -0.45, "pitch":  0.00, "yawTolerance": 0.15, "pitchTolerance": 0.30},
      "right":    {"yaw":  0.45, "pitch":  0.00, "yawTolerance": 0.15, "pitchTolerance": 0.30},
      "up":       {"yaw":  0.00, "pitch":  0.35, "yawTolerance": 0.25, "pitchTolerance": 0.15},
      "down":     {"yaw":  0.00, "pitch": -0.35, "yawTolerance": 0.25, "pitchTolerance": 0.15}
    }
  },
  "camera": {
    "frameTimeoutSeconds": 3
  },
  "captureView": {
    "postSealDismissMs": 900
  },
  "antiSpoof": {
    "minScore": 0.55,
    "modelTag": "MiniFASNetV2+V1SE"
  },
  "faceMatch": {
    "cosineThreshold": 0.45
  }
}
