{
  "schemaVersion": 4,
  "profile": {
    "id": "san-francisco",
    "label": "San Francisco",
    "description": "White-label civic identity Edition for San Francisco. Document-capture flow (App Attest + active liveness + anti-spoof + face match against a back-camera capture). Sunset palette with a Golden Gate hero + launch mark.",
    "requiredPhases": [
      "appAttest",
      "liveness",
      "antiSpoof",
      "faceMatch"
    ],
    "faceMatchSource": "documentPhoto",
    "document": {
      "noun": "identity card",
      "short": "ID"
    }
  },
  "splash": {
    "minDurationMs": 900
  },
  "loading": {
    "phaseThresholdsMs": [
      0,
      1500,
      3500,
      7000
    ]
  },
  "liveness": {
    "scanBudgetSeconds": 15,
    "poseHoldMs": 250,
    "activePoses": [
      "straight",
      "left",
      "right"
    ],
    "frameStride": 2,
    "minConfidence": 0.5,
    "poses": {
      "straight": {
        "yaw": 0,
        "pitch": 0,
        "yawTolerance": 0.18,
        "pitchTolerance": 0.18
      },
      "left": {
        "yaw": -0.45,
        "pitch": 0,
        "yawTolerance": 0.15,
        "pitchTolerance": 0.3
      },
      "right": {
        "yaw": 0.45,
        "pitch": 0,
        "yawTolerance": 0.15,
        "pitchTolerance": 0.3
      },
      "up": {
        "yaw": 0,
        "pitch": 0.35,
        "yawTolerance": 0.25,
        "pitchTolerance": 0.15
      },
      "down": {
        "yaw": 0,
        "pitch": -0.35,
        "yawTolerance": 0.25,
        "pitchTolerance": 0.15
      }
    }
  },
  "camera": {
    "frameTimeoutSeconds": 3
  },
  "captureView": {
    "postSealDismissMs": 900
  },
  "antiSpoof": {
    "minScore": 0.55,
    "modelTag": "MiniFASNetV2+V1SE"
  },
  "faceMatch": {
    "cosineThreshold": 0.55
  },
  "theme": {
    "palette": "sunset",
    "branding": {
      "logo": {
        "asset": "SanFranciscoLogo"
      },
      "hero": {
        "mode": "image",
        "asset": "SanFranciscoHero"
      }
    }
  },
  "session": {
    "authFreshnessSeconds": 600
  },
  "support": {
    "maxPerSession": 3
  },
  "pairing": {
    "enabled": false
  },
  "deployments": [
    {
      "id": "production",
      "name": "Production",
      "description": "Live platform — foundation-global.com",
      "version": "1.0",
      "webUrl": "https://foundation-global.com",
      "plist": "GoogleService-Info"
    },
    {
      "id": "staging",
      "name": "Staging",
      "description": "Test environment — staging.foundation-global.com",
      "version": "1.0-rc",
      "webUrl": "https://staging.foundation-global.com",
      "plist": "GoogleService-Info-staging"
    }
  ],
  "palette": {
    "canvas": "#ffffff",
    "surface": "#fff7f2",
    "border": "#f1ddd0",
    "ink": "#2a160c",
    "muted": "#8a6f60",
    "brand": "#fb7185",
    "brandAlt": "#fbbf24",
    "brandInk": "#be123c",
    "brandInkHover": "#9f1239",
    "gradient": "linear-gradient(100deg, #fb7185, #f97316 55%, #fbbf24)",
    "meshBase": "#fff1ec",
    "meshBlobs": [
      "#fb7185",
      "#fbbf24",
      "#f97316",
      "#f43f5e"
    ]
  }
}
