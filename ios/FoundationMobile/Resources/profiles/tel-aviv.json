{
  "schemaVersion": 4,
  "profile": {
    "id": "tel-aviv",
    "label": "Tel Aviv",
    "description": "White-label smart-city digital identity Edition for Tel Aviv. Document-capture flow (App Attest + active liveness + anti-spoof + face match against a back-camera capture). Ocean palette with a Mediterranean sun/sea hero + launch mark.",
    "requiredPhases": ["appAttest", "liveness", "antiSpoof", "faceMatch"],
    "faceMatchSource": "documentPhoto"
  },
  "splash": {
    "minDurationMs": 900
  },
  "loading": {
    "phaseThresholdsMs": [0, 1500, 3500, 7000]
  },
  "liveness": {
    "scanBudgetSeconds": 15,
    "poseHoldMs": 250,
    "activePoses": ["straight", "left", "right"],
    "frameStride": 2,
    "minConfidence": 0.5,
    "poses": {
      "straight": {"yaw":  0.00, "pitch":  0.00, "yawTolerance": 0.18, "pitchTolerance": 0.18},
      "left":     {"yaw": -0.45, "pitch":  0.00, "yawTolerance": 0.15, "pitchTolerance": 0.30},
      "right":    {"yaw":  0.45, "pitch":  0.00, "yawTolerance": 0.15, "pitchTolerance": 0.30},
      "up":       {"yaw":  0.00, "pitch":  0.35, "yawTolerance": 0.25, "pitchTolerance": 0.15},
      "down":     {"yaw":  0.00, "pitch": -0.35, "yawTolerance": 0.25, "pitchTolerance": 0.15}
    }
  },
  "camera": {
    "frameTimeoutSeconds": 3
  },
  "captureView": {
    "postSealDismissMs": 900
  },
  "antiSpoof": {
    "minScore": 0.55,
    "modelTag": "MiniFASNetV2+V1SE"
  },
  "faceMatch": {
    "cosineThreshold": 0.55
  },
  "theme": {
    "palette": "ocean",
    "branding": {
      "logo": { "asset": "TelAvivLogo" },
      "hero": { "mode": "image", "asset": "TelAvivHero" }
    }
  },
  "session": {
    "authFreshnessSeconds": 600
  },
  "support": {
    "maxPerSession": 3
  },
  "pairing": {
    "enabled": false
  },
  "deployments": [
    {
      "id": "production",
      "name": "Production",
      "description": "Live platform — foundation-global.com",
      "version": "1.0",
      "webUrl": "https://foundation-global.com",
      "plist": "GoogleService-Info"
    },
    {
      "id": "staging",
      "name": "Staging",
      "description": "Test environment — staging.foundation-global.com",
      "version": "1.0-rc",
      "webUrl": "https://staging.foundation-global.com",
      "plist": "GoogleService-Info-staging"
    }
  ]
}
