<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:foundation-global.com</string>
		<string>applinks:voice.foundation-global.com</string>
		<string>applinks:share.foundation-global.com</string>
		<string>applinks:market.foundation-global.com</string>
		<string>applinks:solanavote-devnet.firebaseapp.com</string>
	</array>
	<!--
	2026-04-26 security review M-H-2 / B1 / I1: this is the Release-build
	entitlements file. App Store / TestFlight distribution MUST use
	`production` here; the development sandbox endpoint Apple uses for
	`development` will be rejected by the production CBOR verifier in
	`@plantagoai/attestation/server`.

	Wire-up (manual, one-time, in Xcode):
	  Project → Targets → FoundationMobile → Build Settings (filter to
	  "Code Signing Entitlements") → set the Release configuration to
	  $(SRCROOT)/FoundationMobile/FoundationMobile-Release.entitlements
	  while leaving Debug pointed at the existing
	  FoundationMobile.entitlements.
	-->
	<key>com.apple.developer.devicecheck.appattest-environment</key>
	<string>production</string>
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>TAG</string>
	</array>
</dict>
</plist>
